{
  "name": "touchline",
  "version": "0.5.0",
  "private": true,
  "description": "Touchline — a mobile-first football management game (web + Capacitor native shell).",
  "scripts": {
    "serve": "python -m http.server 5173",
    "test": "node tools/sim-test.mjs --seasons 2",
    "test:quick": "node tools/sim-test.mjs --seasons 1",
    "test:regens": "node tools/regens.mjs",
    "build": "node tools/build.mjs",
    "serve:dist": "python -m http.server 5180 -d dist",
    "cap:sync": "npm run build && npx cap sync",
    "android": "npm run cap:sync && npx cap open android",
    "ios": "npm run cap:sync && npx cap open ios",
    "calibrate": "node tools/calibrate.mjs --seasons 3",
    "check:docs": "node tools/check-docs.mjs",
    "changelog": "node tools/changelog.mjs",
    "test:suite": "node tools/suite.mjs --seasons 3",
    "test:long": "node tools/suite.mjs --seasons 20 --skip-speed",
    "test:realstats": "node tools/realstats.mjs --test",
    "test:worlddef": "node tools/worlddef.mjs --test",
    "test:import": "node tools/import-history.mjs --test",
    "import:history": "node tools/import-history.mjs",
    "docs:sync-status": "node tools/docsync.mjs",
    "docs:synced": "node tools/docsync.mjs --mark",
    "dev-tools": "node tools/devserver.mjs",
    "test:wonderkids": "node tools/wonderkids.mjs --seasons 10",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}

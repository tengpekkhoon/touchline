{
  "name": "touchline",
  "version": "0.5.0",
  "private": true,
  "description": "Touchline \u2014 a mobile-first football management game (web + Capacitor native shell).",
  "scripts": {
    "serve": "python -m http.server 5173",
    "test": "node tools/sim-test.mjs --seasons 2",
    "test:quick": "node tools/sim-test.mjs --seasons 1",
    "test:regens": "node tools/regens.mjs",
    "build": "node tools/build.mjs",
    "serve:dist": "python -m http.server 5180 -d dist",
    "cap:sync": "npm run build && npx cap sync",
    "android": "npm run cap:sync && npx cap open android",
    "ios": "npm run cap:sync && npx cap open ios",
    "calibrate": "node tools/calibrate.mjs --seasons 3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}
